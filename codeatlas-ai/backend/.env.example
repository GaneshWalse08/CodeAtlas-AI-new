# Required: Anthropic API key for file summaries, chat, and risk explanations
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional but strongly recommended: raises GitHub's unauthenticated rate limit
# from 60 req/hr to 5,000 req/hr. Create one at https://github.com/settings/tokens
# (no scopes needed for public repos).
GITHUB_TOKEN=

# Which Claude model to use for summaries / chat
CLAUDE_MODEL=claude-sonnet-4-6

PORT=4000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
